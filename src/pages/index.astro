---
const verificationUrl = "/verify";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0b100e" />
        <meta
            name="description"
            content="A fictional Halloween personnel verification dossier from Catto Industries."
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>Personnel Verification | Catto Industries</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="site-shell">
            <header class="site-header">
                <div class="header-inner">
                    <a
                        class="brand"
                        href="/"
                        aria-label="Catto Industries home"
                    >
                        <span class="brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 42 42" fill="none">
                                <path
                                    d="M21 2 38 11.5v19L21 40 4 30.5v-19L21 2Z"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                />
                            </svg>
                            <span class="brand-mark-inner"></span>
                        </span>
                        <span class="brand-name">
                            CATTO <strong>INDUSTRIES</strong>
                            <small>SECURITY & CONTAINMENT DIVISION</small>
                        </span>
                    </a>
                    <div class="header-meta">
                        <span class="online-dot"></span>
                        <span class="system-label">SYSTEM ONLINE</span>
                        <span class="meta-divider"></span>
                        <time
                            id="system-clock"
                            aria-label="Current local date and time"
                        >
                            <span class="system-date">SYNCING</span>
                            <span class="system-time">--:--:--</span>
                        </time>
                    </div>
                </div>
            </header>

            <main class="main-content">
                <div class="breadcrumb">
                    <span>CATTO INDUSTRIES</span>
                    <span class="slash">/</span>
                    <span>SECURE RECORDS</span>
                    <span class="slash">/</span>
                    <span class="current">PERSONNEL FILE</span>
                </div>

                <section class="page-heading" aria-labelledby="page-title">
                    <div>
                        <h1 id="page-title">
                            PERSONNEL <span>VERIFICATION</span>
                        </h1>
                        <p>
                            Identity record retrieved from the Catto Industries
                            secure archive.
                        </p>
                    </div>
                </section>

                <section
                    class="telemetry-panel"
                    id="security-monitor"
                    aria-labelledby="telemetry-title"
                    hidden
                >
                    <div class="telemetry-heading">
                        <h2 id="telemetry-title">
                            CI SECURITY MONITOR // LIVE TELEMETRY
                        </h2>
                        <div class="telemetry-actions">
                            <span class="anomaly-badge">ANOMALY</span>
                            <button
                                class="telemetry-dismiss"
                                id="dismiss-telemetry"
                                type="button"
                                aria-label="Dismiss security monitor"
                            >
                                ×
                            </button>
                        </div>
                    </div>
                    <p class="telemetry-detection">
                        Personnel ID CI-07-1031-8842 detected.
                    </p>
                    <p class="telemetry-detail">
                        Status mismatch: Subject declared deceased.
                    </p>
                    <p class="telemetry-alert">
                        LAST DETECTED: <time id="last-access">--:--</time> //
                        LOCATION UNKNOWN
                    </p>
                </section>
                <button
                    class="telemetry-reopen"
                    id="show-telemetry"
                    type="button"
                    aria-controls="security-monitor"
                    aria-expanded="false"
                    hidden
                >
                    <span class="reopen-dot" aria-hidden="true"></span>
                    SECURITY ALERT
                    <span aria-hidden="true">↗</span>
                </button>

                <div class="content-grid">
                    <article
                        class="dossier panel"
                        aria-labelledby="record-title"
                    >
                        <div class="hazard-stripe" aria-hidden="true"></div>
                        <div class="panel-title-row">
                            <div class="section-label">
                                <span class="square-dot"></span>
                                <h2 id="record-title">IDENTITY RECORD</h2>
                            </div>
                            <div class="classification-stamp">
                                <span class="stamp-icon">✳</span>
                                <span>
                                    LEVEL 7<br />
                                    <strong>RESTRICTED ACCESS</strong>
                                </span>
                            </div>
                        </div>
                        <div class="dossier-body">
                            <div class="redacted-placeholder">
                                IMAGE REDACTED
                            </div>
                            <div class="identity-column">
                                <div class="identity-top">
                                    <span class="micro-label">
                                        REGISTERED PERSONNEL
                                    </span>
                                    <span class="verified-tag">
                                        <span>✦</span> RECORD FOUND
                                    </span>
                                </div>
                                <div class="person-name">
                                    RICK <span class="period">[REDACTED]</span>
                                </div>
                                <div class="name-subtitle">
                                    FORMER RESEARCH ASSOCIATE <span>·</span>{" "}
                                    DIVISION 07
                                </div>
                                <div class="field-grid">
                                    <div class="field">
                                        <span class="field-label">
                                            PERSONNEL ID NUMBER
                                        </span>
                                        <strong class="mono">
                                            CI-07-1031-8842
                                        </strong>
                                    </div>
                                    <div class="field">
                                        <span class="field-label">
                                            CLEARANCE LEVEL
                                        </span>
                                        <strong>
                                            LEVEL 7{" "}
                                            <span class="field-muted">
                                                / RESTRICTED
                                            </span>
                                        </strong>
                                    </div>
                                    <div class="field">
                                        <span class="field-label">
                                            DEPARTMENT
                                        </span>
                                        <strong>CONTAINMENT & RESEARCH</strong>
                                    </div>
                                    <div class="field">
                                        <span class="field-label">
                                            LAST SEEN
                                        </span>
                                        <strong>
                                            <time
                                                id="last-seen"
                                                aria-live="polite"
                                            >
                                                <span class="last-seen-date">
                                                    SYNCING
                                                </span>
                                                <span class="field-muted">
                                                    {" "}
                                                    /{" "}
                                                    <span class="last-seen-time">
                                                        --:--
                                                    </span>
                                                </span>
                                                <span
                                                    class="last-seen-beacon"
                                                    aria-hidden="true"
                                                ></span>
                                            </time>
                                        </strong>
                                    </div>
                                </div>
                                <div class="status-block">
                                    <div class="status-heading">
                                        <span class="field-label">
                                            PERSONNEL STATUS
                                        </span>
                                        <span class="status-pulse"></span>
                                    </div>
                                    <div class="status-value">
                                        <span class="status-cross">✕</span>{" "}
                                        PRESUMED DECEASED
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="notes-block">
                            <div class="notes-heading">
                                <span class="warning-icon">!</span>
                                <span>PERSONNEL NOTES</span>
                                <span class="notes-code">// HIGH PRIORITY</span>
                            </div>
                            <p>Subject assumed infected, do not approach!</p>
                            <span class="notes-detail">
                                PROTOCOL 07-C REMAINS IN EFFECT. MAINTAIN SAFE
                                DISTANCE.
                            </span>
                        </div>
                        <div class="dossier-footer">
                            <span>
                                DOCUMENT CLASSIFICATION: <b>CONFIDENTIAL</b>
                            </span>
                            <span>REF: CI/07-1031 · CI ARCHIVE // 2026</span>
                        </div>
                    </article>

                    <aside
                        class="sidebar"
                        aria-label="Verification and access information"
                    >
                        <section
                            class="verification panel"
                            aria-labelledby="verify-title"
                        >
                            <div class="panel-title-row">
                                <div class="section-label">
                                    <span class="square-dot"></span>
                                    <h2 id="verify-title">
                                        VERIFY CREDENTIALS
                                    </h2>
                                </div>
                                <span class="scan-icon" aria-hidden="true">
                                    ⌗
                                </span>
                            </div>
                            <p class="verify-intro">
                                Verify this personnel record through the secure
                                portal
                                <span class="scan-instruction">
                                    , or scan the credential below
                                </span>
                                .
                            </p>
                            <a
                                class="verify-button"
                                href={verificationUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                OPEN VERIFICATION PORTAL{" "}
                                <span aria-hidden="true">↗</span>
                            </a>
                            <p class="verify-small">OR SCAN THE CODE BELOW</p>
                            <a
                                class="qr-link"
                                href={verificationUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Open the verification QR code destination in a new tab"
                            >
                                <span class="qr-corner top-left"></span>
                                <span class="qr-corner top-right"></span>
                                <span class="qr-corner bottom-left"></span>
                                <span class="qr-corner bottom-right"></span>
                                <img
                                    src="/verification-qr.svg"
                                    alt="Scannable QR code for this fictional credential"
                                    width="220"
                                    height="220"
                                />
                            </a>
                            <div class="scan-caption">
                                <span class="scan-line"></span> SCAN TO VERIFY{" "}
                                <span class="scan-line"></span>
                            </div>
                            <div class="verify-footer">
                                <span class="online-dot"></span> ENCRYPTED
                                CHANNEL ACTIVE <span>◈ 256-BIT</span>
                            </div>
                        </section>
                        <section
                            class="access-panel panel"
                            id="access-warning"
                            aria-labelledby="access-title"
                        >
                            <div class="access-panel-heading">
                                <h2 id="access-title">
                                    ACCESS WARNING // CLEARANCE REQUIRED
                                </h2>
                                <div class="access-actions">
                                    <span class="warning-badge">WARNING</span>
                                    <button
                                        class="access-dismiss"
                                        id="dismiss-access-warning"
                                        type="button"
                                        aria-label="Dismiss access warning"
                                    >
                                        ×
                                    </button>
                                </div>
                            </div>
                            <p class="access-main">
                                Level 7 clearance is required for this record.
                            </p>
                            <p class="access-detail">
                                Personnel file CI-07-1031-8842 is restricted to
                                authorized staff.
                            </p>
                            <p class="access-alert">
                                UNAUTHORISED ACCESS WILL TRIGGER A SECURITY
                                RESPONSE
                            </p>
                        </section>
                        <button
                            class="access-trigger"
                            id="show-access-warning"
                            type="button"
                            aria-label="Show access warning"
                            aria-controls="access-warning"
                            aria-expanded="false"
                            title="Access warning"
                            hidden
                        >
                            <span aria-hidden="true">⚠︎</span>
                        </button>
                        <div class="sidebar-index">
                            CI-SD // AUTHORIZATION REQUIRED
                        </div>
                    </aside>
                </div>

                <footer class="site-footer">
                    <span>
                        © 2026 CATTO INDUSTRIES{" "}
                        <span class="footer-divider">/</span> ALL RIGHTS
                        RESERVED
                    </span>
                    <span>
                        FICTIONAL HALLOWEEN PROP{" "}
                        <span class="footer-divider">/</span> NOT A REAL
                        GOVERNMENT ID
                    </span>
                </footer>
            </main>
        </div>
        <script>
            const clock = document.getElementById("system-clock");
            const date = clock?.querySelector(".system-date");
            const time = clock?.querySelector(".system-time");
            const lastSeen = document.getElementById("last-seen");
            const lastSeenDate = lastSeen?.querySelector(".last-seen-date");
            const lastSeenTime = lastSeen?.querySelector(".last-seen-time");
            const lastAccess = document.getElementById("last-access");
            const minutesAgo = 15 + Math.floor(Math.random() * 11);
            let seenAt = new Date(Date.now() - minutesAgo * 60_000);
            const dateFormatter = new Intl.DateTimeFormat("en-US", {
                month: "short",
                day: "2-digit",
                year: "numeric",
            });
            const timeFormatter = new Intl.DateTimeFormat("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false,
            });
            const lastSeenFormatter = new Intl.DateTimeFormat("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: false,
            });

            const updateClock = () => {
                if (!clock || !date || !time) return;
                const now = new Date();
                date.textContent = dateFormatter.format(now).toUpperCase();
                time.textContent = timeFormatter.format(now);
                clock.setAttribute("datetime", now.toISOString());
            };
            const updateLastSeen = () => {
                if (!lastSeen || !lastSeenDate || !lastSeenTime) return;
                lastSeenDate.textContent = dateFormatter
                    .format(seenAt)
                    .toUpperCase();
                const seenTime = lastSeenFormatter.format(seenAt);
                lastSeenTime.textContent = seenTime;
                lastSeen.setAttribute("datetime", seenAt.toISOString());
                if (lastAccess) {
                    lastAccess.textContent = seenTime;
                    lastAccess.setAttribute("datetime", seenAt.toISOString());
                }
            };
            updateLastSeen();
            if (clock && date && time) {
                updateClock();
                setInterval(updateClock, 1000);
            }

            const monitor = document.getElementById("security-monitor");
            const dismissAlert = document.getElementById("dismiss-telemetry");
            const showAlert = document.getElementById("show-telemetry");

            if (monitor && dismissAlert && showAlert) {
                let dismissTimer: ReturnType<typeof setTimeout>;
                let exitTimer: ReturnType<typeof setTimeout>;
                const dismissMonitor = (moveFocus = false) => {
                    clearTimeout(dismissTimer);
                    if (
                        monitor.hidden ||
                        monitor.classList.contains("is-dismissing")
                    )
                        return;
                    const focusWasInside = monitor.contains(
                        document.activeElement,
                    );
                    const finishDismissal = () => {
                        monitor.hidden = true;
                        monitor.classList.remove("is-dismissing");
                        showAlert.hidden = false;
                        showAlert.setAttribute("aria-expanded", "false");
                        if (moveFocus || focusWasInside) showAlert.focus();
                    };
                    if (
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches
                    ) {
                        finishDismissal();
                    } else {
                        monitor.classList.add("is-dismissing");
                        exitTimer = setTimeout(finishDismissal, 250);
                    }
                };
                const scheduleDismiss = () => {
                    clearTimeout(dismissTimer);
                    dismissTimer = setTimeout(() => dismissMonitor(), 5000);
                };

                dismissAlert.addEventListener("click", () =>
                    dismissMonitor(true),
                );
                showAlert.addEventListener("click", () => {
                    clearTimeout(exitTimer);
                    monitor.classList.remove("is-dismissing");
                    monitor.hidden = false;
                    showAlert.hidden = true;
                    showAlert.setAttribute("aria-expanded", "true");
                    dismissAlert.focus();
                    scheduleDismiss();
                });
                const statusBlock = document.querySelector(".status-block");
                if (statusBlock) {
                    let revealTimer: ReturnType<typeof setTimeout> | undefined;
                    const observer = new IntersectionObserver(
                        (entries) => {
                            if (
                                !entries.some(
                                    (entry) => entry.intersectionRatio >= 0.5,
                                )
                            ) {
                                clearTimeout(revealTimer);
                                revealTimer = undefined;
                                return;
                            }
                            if (revealTimer !== undefined) return;
                            const revealDelay =
                                1000 + Math.floor(Math.random() * 2001);
                            revealTimer = setTimeout(() => {
                                revealTimer = undefined;
                                const rect =
                                    statusBlock.getBoundingClientRect();
                                const visibleHeight = Math.max(
                                    0,
                                    Math.min(rect.bottom, window.innerHeight) -
                                        Math.max(rect.top, 0),
                                );
                                if (visibleHeight < rect.height / 2) return;
                                observer.disconnect();
                                seenAt = new Date();
                                updateLastSeen();
                                lastSeen?.classList.add("is-updated");
                                monitor.hidden = false;
                                scheduleDismiss();
                            }, revealDelay);
                        },
                        { threshold: 0.5 },
                    );
                    const initialScrollY = window.scrollY;
                    const startObservingOnScroll = () => {
                        if (window.scrollY === initialScrollY) return;
                        window.removeEventListener(
                            "scroll",
                            startObservingOnScroll,
                        );
                        observer.observe(statusBlock);
                    };
                    window.addEventListener("scroll", startObservingOnScroll, {
                        passive: true,
                    });
                }
            }

            const accessPanel = document.getElementById("access-warning");
            const accessTrigger = document.getElementById(
                "show-access-warning",
            );
            const accessDismiss = document.getElementById(
                "dismiss-access-warning",
            );
            if (accessPanel && accessTrigger && accessDismiss) {
                let accessExitTimer: ReturnType<typeof setTimeout>;
                let accessDismissTimer: ReturnType<typeof setTimeout>;
                const closeAccess = (moveFocus = false) => {
                    clearTimeout(accessDismissTimer);
                    if (
                        accessPanel.hidden ||
                        accessPanel.classList.contains("is-dismissing")
                    )
                        return;
                    const focusWasInside = accessPanel.contains(
                        document.activeElement,
                    );
                    const finishDismissal = () => {
                        accessPanel.hidden = true;
                        accessPanel.classList.remove("is-dismissing");
                        accessTrigger.hidden = false;
                        accessTrigger.setAttribute("aria-expanded", "false");
                        if (moveFocus || focusWasInside) accessTrigger.focus();
                    };
                    if (
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches
                    ) {
                        finishDismissal();
                    } else {
                        accessPanel.classList.add("is-dismissing");
                        accessExitTimer = setTimeout(finishDismissal, 250);
                    }
                };
                const scheduleAccessDismiss = () => {
                    clearTimeout(accessDismissTimer);
                    accessDismissTimer = setTimeout(() => closeAccess(), 5000);
                };
                accessTrigger.addEventListener("click", () => {
                    clearTimeout(accessExitTimer);
                    accessPanel.classList.remove("is-dismissing");
                    accessPanel.hidden = false;
                    accessTrigger.hidden = true;
                    accessTrigger.setAttribute("aria-expanded", "true");
                    accessDismiss.focus();
                    scheduleAccessDismiss();
                });
                accessDismiss.addEventListener("click", () =>
                    closeAccess(true),
                );
                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && !accessPanel.hidden)
                        closeAccess(true);
                });
                scheduleAccessDismiss();
            }
        </script>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }
    :global(html) {
        background: #0b100e;
    }
    :global(body) {
        margin: 0;
        color: #dce2d9;
        font-family: "DM Sans", sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    :global(a) {
        color: inherit;
    }
    :global(::selection) {
        background: #ad5144;
        color: #fff;
    }
    .site-shell {
        min-height: 100vh;
        background:
            radial-gradient(
                ellipse 58% 40% at 52% 39%,
                #1b2721 0%,
                transparent 100%
            ),
            linear-gradient(rgba(126, 151, 124, 0.024) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(126, 151, 124, 0.024) 1px,
                transparent 1px
            ),
            #0b100e;
        background-size:
            auto,
            54px 54px,
            54px 54px,
            auto;
    }
    .site-header {
        border-bottom: 1px solid #27342d;
        background: rgba(12, 18, 15, 0.93);
    }
    .header-inner {
        max-width: 1260px;
        min-height: 88px;
        padding: 0 36px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        text-decoration: none;
    }
    .brand-mark {
        position: relative;
        width: 43px;
        height: 43px;
        color: #c7d6bd;
        display: block;
        flex: none;
    }
    .brand-mark svg {
        width: 100%;
        height: 100%;
    }
    .brand-mark-inner {
        position: absolute;
        inset: 0;
        background: currentColor;
        -webkit-mask: url("/catto-industries-mark.svg") center / contain
            no-repeat;
        mask: url("/catto-industries-mark.svg") center / contain no-repeat;
    }
    .brand-name {
        font-family: "Barlow Condensed", sans-serif;
        font-size: 25px;
        letter-spacing: 0.075em;
        font-weight: 700;
        line-height: 0.95;
        white-space: nowrap;
    }
    .brand-name strong {
        color: #b9c9b0;
        font-weight: 500;
    }
    .brand-name small {
        display: block;
        font-family: "DM Mono", monospace;
        color: #748278;
        font-size: 8px;
        letter-spacing: 0.14em;
        margin-top: 7px;
    }
    .header-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #9ba99b;
        font:
            10px "DM Mono",
            monospace;
        letter-spacing: 0.09em;
        white-space: nowrap;
    }
    #system-clock {
        display: flex;
        gap: 10px;
        font-variant-numeric: tabular-nums;
    }
    .system-time {
        color: #c4d2bd;
    }
    .online-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        color: #9bba82;
        background: #9bba82;
        display: inline-block;
        box-shadow: 0 0 11px #80aa68;
        flex: none;
    }
    .meta-divider {
        height: 17px;
        width: 1px;
        margin: 0 9px;
        background: #344137;
    }
    .main-content {
        max-width: 1260px;
        padding: 0 36px;
        margin: 0 auto;
    }
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 22px;
        color: #728077;
        font:
            10px "DM Mono",
            monospace;
        letter-spacing: 0.11em;
    }
    .breadcrumb .slash {
        color: #3a483e;
    }
    .breadcrumb .current {
        color: #c4d2bd;
    }
    .page-heading {
        margin: 28px 0 22px;
    }
    h1,
    h2,
    p {
        margin: 0;
    }
    h1 {
        margin: 0 0 8px;
        font:
            700 clamp(48px, 5.3vw, 76px)/0.98 "Barlow Condensed",
            sans-serif;
        letter-spacing: 0.035em;
        color: #f0f2ea;
    }
    h1 span {
        color: #a6bd95;
    }
    .page-heading p {
        color: #85948a;
        font-size: 14px;
    }
    .classification-stamp {
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #855349;
        padding: 7px 10px;
        color: #db8170;
        font:
            9px/1.4 "DM Mono",
            monospace;
        letter-spacing: 0.12em;
        white-space: nowrap;
        background: rgba(113, 48, 43, 0.08);
    }
    .classification-stamp strong {
        font-size: 10px;
        font-weight: 500;
    }
    .stamp-icon {
        font-size: 22px;
        line-height: 1;
    }
    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(300px, 0.93fr);
        gap: 20px;
        align-items: start;
    }
    .panel {
        background: #141d18;
        border: 1px solid #35463a;
        box-shadow: 0 18px 55px #0003;
    }
    .dossier {
        overflow: hidden;
    }
    .hazard-stripe {
        height: 6px;
        background: repeating-linear-gradient(
            115deg,
            #a9684a 0 17px,
            #28362b 17px 30px
        );
        border-bottom: 1px solid #495840;
