<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0b100e" />
        <meta name="robots" content="noindex" />
        <script is:inline>
            document.documentElement.classList.add("js");
        </script>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>Verification Result | Catto Industries</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <main class="reveal-page">
            <div class="topline">
                <span>
                    CATTO INDUSTRIES{" "}
                    <span class="muted">// SECURITY & CONTAINMENT</span>
                </span>
                <span>CI-07-1031-8842</span>
            </div>
            <section class="reveal-card" aria-labelledby="reveal-title">
                <div class="card-top">
                    <span class="status-light" aria-hidden="true"></span>{" "}
                    <span id="scan-status">CI SECURE GATEWAY</span>
                    <span class="card-index">// FILE 007</span>
                </div>
                <div class="verification-screen" aria-live="polite">
                    <span class="gateway-label">
                        CI SECURE GATEWAY // AUTHORIZATION REQUEST
                    </span>
                    <h2>
                        VERIFYING
                        <br />
                        <span>IDENTITY.</span>
                    </h2>
                    <div class="verification-log">
                        <p class="verification-step" id="step-hash">
                            <span class="step-icon" aria-hidden="true">
                                ◌
                            </span>{" "}
                            Submitting hash to server...
                        </p>
                        <p
                            class="verification-step"
                            id="step-credentials"
                            hidden
                        >
                            <span class="step-icon" aria-hidden="true">
                                ◌
                            </span>{" "}
                            Verifying credentials...
                        </p>
                        <p
                            class="verification-step granted"
                            id="step-granted"
                            hidden
                        >
                            <span class="step-icon" aria-hidden="true">
                                ✓
                            </span>{" "}
                            Access granted.
                        </p>
                    </div>
                    <div class="verification-progress" aria-hidden="true">
                        <span id="progress-fill"></span>
                    </div>
                    <p class="gateway-footer">
                        PLEASE DO NOT CLOSE THIS WINDOW // CI-07-1031-8842
                    </p>
                </div>
                <div class="hash-gate" aria-labelledby="gate-title">
                    <span class="gateway-label">
                        CI SECURE GATEWAY // IDENTITY CONFIRMED
                    </span>
                    <h2 id="gate-title">
                        ACCESS
                        <br />
                        <span>GRANTED.</span>
                    </h2>
                    <p>
                        Credential verified. Your encrypted verification hash is
                        ready to view.
                    </p>
                    <div class="hash-preview">
                        <span>VERIFICATION HASH</span>
                        <span>•••• •••• •••• 8842</span>
                    </div>
                    <button id="view-hash" class="hash-button" type="button">
                        VIEW VERIFICATION HASH <span aria-hidden="true">↗</span>
                    </button>
                    <small>CI-07-1031-8842 // LEVEL 7 CLEARANCE</small>
                </div>
                <div class="reveal-content">
                    <span class="eyebrow">
                        UNAUTHORISED ACCESS <span>—</span> SESSION FLAGGED
                    </span>
                    <h1 id="reveal-title" tabindex="-1">
                        LOCATION
                        <br />
                        <span>LOGGED.</span>
                    </h1>
                    <div class="trap-warning">
                        <span class="trap-icon" aria-hidden="true">
                            !
                        </span>
                        <p>
                            SECURITY PERSONNEL ARE ON THE WAY.
                            <br />
                            <strong>DO NOT MOVE.</strong>
                            <span class="trap-instructions">
                                KEEP YOUR HANDS VISIBLE. DO NOT CLOSE THIS
                                WINDOW.
                                <br />
                                AWAIT FURTHER INSTRUCTIONS. OR DONT. THIS IS A
                                JOKE.
                            </span>
                        </p>
                    </div>
                    <p class="subtitle">
                        This session has been logged. Never gonna give you up.
                    </p>
                    <div class="media-frame">
                        <div class="frame-label">
                            <span>ARCHIVE FOOTAGE // SUBJECT R.A.</span>
                            <span>● REC</span>
                        </div>
                        <img
                            class="animated-gif"
                            src="/rickroll.gif"
                            alt="Rick Astley singing and dancing in the Never Gonna Give You Up music video"
                            width="320"
                            height="240"
                        />
                        <img
                            class="still-frame"
                            src="/rickroll-still.png"
                            alt="Rick Astley at a microphone"
                            width="320"
                            height="240"
                        />
                        <div class="frame-bottom">
                            <span>FEED 07</span>
                            <span>DECLASSIFIED</span>
                        </div>
                    </div>
                    <div class="audio-section">
                        <div class="audio-heading">
                            <span class="audio-bars" aria-hidden="true">
                                <i></i>
                                <i></i>
                                <i></i>
                                <i></i>
                                <i></i>
                            </span>
                            <span>AUDIO TRANSMISSION</span>
                        </div>
                        <audio
                            id="rickroll-audio"
                            src="/rickroll.mp3"
                            loop
                            controls
                            preload="auto"
                        >
                            Your browser does not support audio playback.
                        </audio>
                        <p
                            id="audio-status"
                            class="audio-status"
                            aria-live="polite"
                        >
                            Attempting to play audio…
                        </p>
                        <button
                            id="play-audio"
                            class="play-button"
                            type="button"
                            hidden
                        >
                            ▶ TAP TO PLAY AUDIO
                        </button>
                    </div>
                    <section class="audit-panel" aria-labelledby="audit-title">
                        <div class="audit-heading">
                            <h2 id="audit-title">SESSION AUDIT TRAIL</h2>
                            <span>INCIDENT REF // 07</span>
                        </div>
                        <dl class="audit-metadata">
                            <div>
                                <dt>SESSION ID</dt>
                                <dd id="audit-session-id">PENDING</dd>
                            </div>
                            <div>
                                <dt>DATE OF ACCESS</dt>
                                <dd>
                                    <time id="audit-accessed">--</time>
                                </dd>
                            </div>
                            <div>
                                <dt>CREDENTIAL ACCESSED</dt>
                                <dd>CI-07-1031-8842</dd>
                            </div>
                        </dl>
                        <div class="audit-log-label">
                            <span>RECENT EVENTS</span>
                            <span>SESSION TRACE</span>
                        </div>
                        <ol id="audit-events" class="audit-events"></ol>
                    </section>
                    <a class="return-link" href="/?containmentAck=yes">
                        ← RETURN TO PERSONNEL FILE
                    </a>
                </div>
                <div class="card-footer">
                    <span>CATTO INDUSTRIES // HALLOWEEN 2026</span>
                    <span>YOU KNOW THE RULES.</span>
                </div>
            </section>
            <p class="disclaimer">
                A FICTIONAL HALLOWEEN SURPRISE · NOT A REAL GOVERNMENT SERVICE ·
                NO DATA IS COLLECTED OR STORED
            </p>
        </main>
        <script>
            const audio =
                document.querySelector<HTMLAudioElement>("#rickroll-audio");
            const status = document.getElementById("audio-status");
            const playButton = document.getElementById("play-audio");

            const card = document.querySelector(".reveal-card");
            const hashStep = document.getElementById("step-hash");
            const credentialsStep = document.getElementById("step-credentials");
            const grantedStep = document.getElementById("step-granted");
            const hashButton = document.getElementById("view-hash");
            const progress = document.getElementById("progress-fill");
            const scanStatus = document.getElementById("scan-status");
            const auditSessionId = document.getElementById("audit-session-id");
            const auditAccessed = document.getElementById("audit-accessed");
            const auditEvents = document.getElementById("audit-events");
            const timestampFormat = new Intl.DateTimeFormat("en-GB", {
                year: "numeric",
                month: "short",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false,
                timeZoneName: "short",
            });
            const eventTimeFormat = new Intl.DateTimeFormat("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false,
            });
            const wait = (ms: number) =>
                new Promise<void>((resolve) => setTimeout(resolve, ms));

            if (
                audio &&
                status &&
                playButton &&
                card &&
                hashStep &&
                credentialsStep &&
                grantedStep &&
                hashButton &&
                scanStatus &&
                progress &&
                auditSessionId &&
                auditAccessed &&
                auditEvents
            ) {
                const accessedAt = new Date();
                const randomPart =
                    globalThis.crypto?.randomUUID?.() ??
                    Math.random().toString(16).slice(2);
                auditSessionId.textContent = `CI-S-${randomPart.slice(0, 8).toUpperCase()}`;
                auditAccessed.textContent = timestampFormat.format(accessedAt);
                auditAccessed.setAttribute(
                    "datetime",
                    accessedAt.toISOString(),
                );

                const recordEvent = (label: string) => {
                    const occurredAt = new Date();
                    const entry = document.createElement("li");
                    const time = document.createElement("time");
                    const description = document.createElement("span");
                    time.dateTime = occurredAt.toISOString();
                    time.textContent = eventTimeFormat.format(occurredAt);
                    description.textContent = label;
                    entry.append(time, description);
                    auditEvents.append(entry);
                };
                recordEvent("SESSION OPENED");

                audio.addEventListener("play", () => {
                    card.classList.add("is-playing");
                    status.textContent = "Audio transmission active.";
                    playButton.hidden = true;
                });
                audio.addEventListener("pause", () =>
                    card.classList.remove("is-playing"),
                );

                playButton.addEventListener("click", () => {
                    audio
                        .play()
                        .then(() => {
                            status.textContent = "Audio transmission active.";
                            playButton.hidden = true;
                        })
                        .catch(() => {
                            status.textContent =
                                "Playback unavailable. Try the audio controls above.";
                        });
                });

                hashButton.addEventListener("click", () => {
                    // Play directly in the click handler to preserve the browser's user gesture.
                    const playback = audio.play();
                    card.classList.add("is-revealed");
                    scanStatus.textContent = "UNAUTHORISED ACCESS";
                    recordEvent("VERIFICATION HASH OPENED // SESSION FLAGGED");
                    document.getElementById("reveal-title")?.focus();
                    playback
                        .then(() => {
                            status.textContent = "Audio transmission active.";
                        })
                        .catch(() => {
                            status.textContent =
                                "Playback was blocked. Tap below to hear it.";
                            playButton.hidden = false;
                        });
                });

                const runVerification = async () => {
                    await wait(1100);
                    hashStep.classList.add("completed");
                    hashStep.querySelector(".step-icon")!.textContent = "✓";
                    recordEvent("HASH CHECK COMPLETE");
                    credentialsStep.hidden = false;
                    progress.style.width = "65%";

                    await wait(1350);
                    credentialsStep.classList.add("completed");
                    credentialsStep.querySelector(".step-icon")!.textContent =
                        "✓";
                    recordEvent("CREDENTIAL CHECK COMPLETE");
                    grantedStep.hidden = false;
                    progress.style.width = "100%";

                    await wait(1100);
                    card.classList.add("is-authorized");
                    scanStatus.textContent = "ACCESS GRANTED";
                    recordEvent("ACCESS GRANTED");
                    hashButton.focus();
                };
                runVerification();
            }
        </script>
    </body>
</html>

